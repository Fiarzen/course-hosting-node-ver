{
  "name": "courses-node-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "clearMocks": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1053.0",
    "@aws-sdk/s3-request-presigner": "3.1053.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/stripe": "8.0.416",
    "bcrypt": "^6.0.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "multer": "1.4.5-lts.2",
    "pg": "8.17.2",
    "stripe": "22.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/multer": "1.4.13",
    "@types/node": "22.15.30",
    "@types/supertest": "7.2.0",
    "jest": "30.4.2",
    "prisma": "^7.8.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3"
  }
}
