# Local development env vars for courses-node-backend
PORT=8080
DATABASE_URL=postgresql://course_user:course_password@localhost:5432/coursedb?schema=public
CORS_ALLOWED_ORIGINS=https://mind-leaf.netlify.app,http://localhost:3000,http://127.0.0.1:3000
AWS_S3_ENABLED=false
AWS_S3_BUCKET_NAME=
AWS_REGION=eu-west-1

# Stripe (one-time payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel
