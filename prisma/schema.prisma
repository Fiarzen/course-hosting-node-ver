generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CoursePurchaseStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

model User {
  id                        Int       @id @default(autoincrement())
  name                      String?
  email                     String    @unique
  password                  String
  role                      String    @default("STUDENT")
  authToken                 String?   @unique
  authTokenExpiry           DateTime?
  passwordResetToken           String?
  passwordResetTokenExpiry     DateTime?
  emailVerified                Boolean   @default(false)
  emailVerificationToken       String?
  emailVerificationTokenExpiry DateTime?

  coursesAuthored           Course[]  @relation("CourseAuthor")
  enrollments               CourseEnrollment[]
  lessonProgress            LessonProgress[]
  purchases                 CoursePurchase[]
}

model Course {
  id                    Int       @id @default(autoincrement())
  title                 String
  description           String
  restrictedToAllowList Boolean   @default(false)
  isPaid                Boolean   @default(false)
  priceCents            Int?
  currency              String?

  authorId              Int?
  author                User?     @relation("CourseAuthor", fields: [authorId], references: [id])

  lessons               Lesson[]
  enrollments           CourseEnrollment[]
  allowedEmails         CourseAllowedEmail[]
  purchases             CoursePurchase[]
  assessments           Assessment[]
}

model CoursePurchase {
  id                 Int                  @id @default(autoincrement())
  status             CoursePurchaseStatus @default(PENDING)
  paymentMethod      String               @default("STRIPE")
  checkoutSessionId  String?              @unique
  paymentIntentId    String?
  stripeCustomerId   String?
  paypalOrderId      String?              @unique
  paypalCaptureId    String?
  amountCents        Int
  currency           String
  paidAt             DateTime?
  expiresAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  userId             Int
  user               User                 @relation(fields: [userId], references: [id])

  courseId           Int
  course             Course               @relation(fields: [courseId], references: [id])

  @@index([userId, courseId])
  @@index([status])
  @@index([paymentMethod])
  @@index([checkoutSessionId])
  @@index([paymentIntentId])
  @@index([paypalOrderId])
}

model StripeWebhookEvent {
  id            Int      @id @default(autoincrement())
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())
}

model CourseAllowedEmail {
  id       Int    @id @default(autoincrement())
  email    String

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  @@unique([courseId, email])
}

model Lesson {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  videoUrl   String?
  pdfUrl     String?
  orderIndex Int?

  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id])

  progress   LessonProgress[]
}

model CourseEnrollment {
  id        Int      @id @default(autoincrement())
  enrolledAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model LessonProgress {
  id          Int      @id @default(autoincrement())
  completed   Boolean  @default(false)
  completedAt DateTime?

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  lessonId    Int
  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model Assessment {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())

  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  questions   AssessmentQuestion[]

  @@index([courseId])
}

model AssessmentQuestion {
  id           Int      @id @default(autoincrement())
  prompt       String
  orderIndex   Int      @default(0)

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  choices      AssessmentChoice[]

  @@index([assessmentId])
}

model AssessmentChoice {
  id         Int      @id @default(autoincrement())
  text       String
  isCorrect  Boolean  @default(false)
  orderIndex Int      @default(0)

  questionId Int
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}
